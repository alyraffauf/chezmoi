{
    "chat.agent.enabled": true,
    "workbench.colorTheme": "Catppuccin Frappé",
    "workbench.iconTheme": "catppuccin-frappe",
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "redhat.telemetry.enabled": false,
    "git.openRepositoryInParentFolders": "always",
    "files.autoSave": "afterDelay",
    "editor.formatOnSave": true,
    "editor.minimap.size": "fill",
    "chat.viewSessions.orientation": "stacked",
    "chat.byokUtilityModelDefault": "mainAgent",
    "chat.disableAIFeatures": false,
    "chat.editor.fontSize": 15,
    "chat.fontSize": 15,
    "claudeCode.preferredLocation": "panel",
    "containers.containerClient": "com.microsoft.visualstudio.containers.podman",
    "containers.orchestratorClient": "com.microsoft.visualstudio.containers.orchestrators.podmancompose",
    "editor.fontSize": 14,
    "editor.formatOnPaste": true,
    "files.autoSaveDelay": 500,
    "files.autoSaveWorkspaceFilesOnly": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "workbench.editor.editorActionsLocation": "titleBar",
    "terminal.integrated.fontLigatures.enabled": true,
    "editor.fontFamily": "'CaskaydiaCove Nerd Font', Menlo, Monaco, 'Courier New', monospace",
    "ansible.validation.lint.autoFixOnSave": true,
    "python.analysis.autoFormatStrings": true,
    "editor.tabCompletion": "on",
    "github.copilot.completions.chat.enabled": true,
    "catppuccin.italicKeywords": false,
    "catppuccin.italicComments": false
}
